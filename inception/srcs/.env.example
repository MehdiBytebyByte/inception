# ------------------------------------------------------------------
# ft_inception environment template
# ------------------------------------------------------------------
# Copy this file to `.env` in the same directory and adjust the values:
#
#   cp .env.example .env
#
# NOTE: `.env` is git-ignored on purpose — never commit real secrets.
# These are sample values used by the local docker-compose setup.
# ------------------------------------------------------------------

# ---- Domain (must match the CN of the self-signed TLS certificate
#       and the server_name in nginx.conf) ----
DOMAIN_NAME=<login>.42.fr

# ---- Database (MariaDB) ----
DB_NAME=wordpress
DB_USER=wpuser
DB_PASS=changeme
MYSQL_ROOT_PASSWORD=changeme-root

# ---- WordPress ----
# Service name of the database container (see docker-compose.yml)
DB_HOST=mariadb
WP_TITLE=Inception

# Admin account
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=changeme-admin
WP_ADMIN_EMAIL=you@student.42.fr

# Author account
WP_USER=author
WP_USER_PASSWORD=changeme-author
WP_USER_EMAIL=author@student.42.fr
