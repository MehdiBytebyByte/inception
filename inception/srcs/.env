DOMAIN_NAME=mboughra.42.fr

# --- Database Config (Unchanged) ---
DB_NAME=wordpress
DB_USER=wpuser
DB_PASS=wpsecret
MYSQL_ROOT_PASSWORD=rootsecret

# --- WordPress Config ---
# NEW: Your script needs to know WHERE the database is.
# This must match the service name in your docker-compose.yml (usually 'mariadb')
DB_HOST=mariadb

# NEW: Your script needs a title for the website
WP_TITLE=Inception

# Admin Account
WP_ADMIN_USER=mboughra
WP_ADMIN_PASSWORD=adminsecret
WP_ADMIN_EMAIL=mboughra@student.42.fr

# Author Account
WP_USER=author
WP_USER_PASSWORD=authorsecret
WP_USER_EMAIL=author@student.42.fr